{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Keeper",
  "version": "../package.json",
  "identifier": "com.lokemoon.tunnel-keeper",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tunnel Keeper",
        "width": 980,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#12141a"
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "DeveloperTool",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
